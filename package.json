{
  "name": "net-test-tool-pro",
  "version": "1.5.7",
  "description": "专业网络测试工具 - 集成 HRUFT 可靠 UDP 传输",
  "main": "main.js",
  "author": "jinbilianshao <2013182991@qq.com>",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build:assets": "node scripts/build-assets.js",
    "build": "npm run build:assets && electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:publishable": "electron-builder --win --linux -p never",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "setup:hruft": "node scripts/setup-hruft.js",
    "setup:binaries": "node scripts/download-binaries.js",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prebuild": "node scripts/pre-build-check.js",
    "build:rpm": "electron-builder --linux rpm -p never"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "electron-updater": "^6.8.11",
    "iconv-lite": "^0.7.2"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9.39.2",
    "globals": "^17.14.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1"
  },
  "build": {
    "appId": "com.nettesttool.pro",
    "productName": "NetTestTool Pro",
    "directories": {
      "output": "app_file",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!bin/**/*",
      "!tests/**/*",
      "!coverage/**/*",
      "!app_file/**/*",
      "!build/**/*",
      "!scripts/**/*",
      "!temp/**/*",
      "!dist/**/*",
      "!**/*.test.js",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "asarUnpack": [
      "node_modules/iconv-lite/**/*"
    ],
    "win": {
      "icon": "./main.ico",
      "extraResources": [
        {
          "from": "bin/windows",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        "portable"
      ],
      "legalTrademarks": "NetTestTool Pro",
      "fileAssociations": [
        {
          "ext": "ntt",
          "name": "NetTestTool Project",
          "description": "NetTestTool Project File",
          "role": "Editor"
        }
      ],
      "artifactName": "NetTestToolPro-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NetTestTool Pro",
      "installerIcon": "./main.ico",
      "uninstallerIcon": "./main.ico",
      "artifactName": "NetTestToolPro-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NetTestToolPro-Portable.exe"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "extraResources": [
        {
          "from": "bin/mac",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "background": "build/background.png",
      "icon": "build/icon.icns",
      "iconSize": 128,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "icon": "build/icons",
      "category": "Network",
      "maintainer": "jinbilianshao <2013182991@qq.com>",
      "synopsis": "Professional Network Testing Tool",
      "description": "NetTestTool Pro is a comprehensive network testing tool with HRUFT reliable UDP transmission support.",
      "extraResources": [
        {
          "from": "bin/linux",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "appImage": {
      "artifactName": "NetTestToolPro-${version}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-4t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "JinBiLianShao",
      "repo": "NetTestTool"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JinBiLianShao/NetTestTool.git"
  },
  "bugs": {
    "url": "https://github.com/JinBiLianShao/NetTestTool/issues"
  },
  "homepage": "https://github.com/JinBiLianShao/NetTestTool#readme",
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "lib/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "verbose": true
  }
}
